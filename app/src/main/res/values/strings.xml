    <string name="tip_light_avoid">A dim room hides the item and darkens the cutout.</string>
    <string name="tip_light_better">Daylight from a window, no flash.</string>
    <string name="tip_bg_avoid">Busy patterns blend into the item and confuse the cutout.</string>
    <string name="tip_bg_better">A plain surface that contrasts with the item.</string>
    <string name="tip_framing_avoid">Edges that touch the frame get cut off.</string>
    <string name="tip_framing_better">The whole item, with space all around.</string>
    <string name="tip_angle_avoid">Shooting at a slant distorts the shape.</string>
    <string name="tip_angle_better">Lay it flat and shoot from straight above.</string>
    <string name="tip_flash_title">Turn the flash off</string>
    <string name="tip_flash_body">Flash makes glare and harsh shadows. Move closer to a window instead.</string>
    <string name="tip_focus_title">Hold still and tap to focus</string>
    <string name="tip_focus_body">A sharp photo cuts out cleanly.</string>
    <string name="tip_flaws_title">Show flaws honestly</string>
    <string name="tip_flaws_body">Mark stains or tears with Flaws. Each gets its own close-up, so buyers know what they\'re getting.</string>
    <string name="shot_front_body">The whole item, flat and straight. This is your main photo.</string>
    <string name="shot_back_body">Turn it over and shoot the same way.</string>
    <string name="shot_label_body">Close enough to read the brand.</string>
    <string name="shot_tag_body">Size, material and care, so buyers don\'t have to ask.</string>
    <string name="shot_detail_body">Fabric, zip, buttons or print, up close.</string>
    <string name="shot_flaw_body">A close-up of each stain, tear or mark.</string>
    <string name="shot_measure_body">A tape across the chest or along the length.</string>
