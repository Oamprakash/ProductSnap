    <string name="intro_purpose_title">Clean listing photos from your phone</string>
    <string name="intro_purpose_body">Shoot your item anywhere, even on the floor. ProductSnap removes the clutter, fixes the light and sizes the photo for where you sell.</string>
    <string name="intro_step1_title">Pick a photo</string>
    <string name="intro_step1_body">Tap One photo on Home, or Batch to do up to 30 at once.</string>
    <string name="intro_step2_title">Clean it up</string>
    <string name="intro_step2_body">Remove the background, then use the Light, Background and Crop tabs if you want to adjust.</string>
    <string name="intro_step3_title">Save or share</string>
    <string name="intro_step3_body">Save to your gallery, or share straight to your eBay, Vinted or Depop app.</string>
    <string name="intro_how_title">Three steps per photo</string>
    <string name="intro_how_body">Everything happens on one screen. After an edit, hold Compare to see the original.</string>
    <string name="intro_why1_title">Honest about condition</string>
    <string name="intro_why1_body">Tap stains or tears to circle them. Each one is also saved as a close-up photo.</string>
    <string name="intro_why2_title">Many photos at once</string>
    <string name="intro_why2_body">Up to 30 photos with the same look. Photos that need a second look are flagged.</string>
    <string name="intro_why3_title">Private</string>
    <string name="intro_why3_body">Every edit happens on your phone. Your photos are never uploaded.</string>
    <string name="intro_why_title">Made for resellers</string>
    <string name="intro_why_body">Pick where you sell and every photo comes out the right shape. Change it anytime from Home, where the bulb has photo tips.</string>
